+#pragma once
+#include <map>
+#include <string>
+#include <stdint.h>
+inline std::map<std::string,unsigned> saved_preferences;
+inline bool fail_save=false;
+class Preferences {
+  std::string ns;
+public:
+  bool begin(const char *name,bool){ns=name;return true;}
+  void end(){}
+  bool getBool(const char *key,bool fallback){return getUChar(key,fallback);}
+  uint8_t getUChar(const char *key,uint8_t fallback){auto i=saved_preferences.find(ns+"/"+key);return i==saved_preferences.end()?fallback:i->second;}
+  size_t putUChar(const char *key,uint8_t value){if(fail_save)return 0;saved_preferences[ns+"/"+key]=value;return 1;}
+  size_t putBool(const char *key,bool value){return putUChar(key,value);}
+};
--- /dev/null
+++ b/tests/test_panel_setup.cpp
@@ -0,0 +1,22 @@
+#include "panel_setup.h"
+#include <Preferences.h>
+#include <Arduino.h>
+#include <LittleFS.h>
+#include <cassert>
+int main(){
+  using namespace panel_setup;
+  assert(boot() && active() && step()==Step::Welcome);
+  for (auto s : {Step::Wifi,Step::Account,Step::Machine,Step::RecipesTour,Step::Ready,Step::Done}){
+    assert(save(s));assert(boot());assert(step()==s);
+  }
+  assert(!active());
+  fail_save=true;assert(!save(Step::Welcome));assert(step()==Step::Done);
+  assert(!request_reset());assert(!ESP.restarted);fail_save=false;
+  saved_preferences["acct/token"]=1;saved_preferences["panel/ssid"]=1;saved_preferences["panel-pair/peer"]=1;
+  assert(request_reset());assert(ESP.restarted); // No data wiped while services could be active.
+  assert(saved_preferences.count("acct/token") && local_files_present);
+  fail_format=true;assert(!boot());assert(saved_preferences.count("first-use/reset"));assert(saved_preferences.count("acct/token"));
+  fail_format=false;assert(boot());assert(active() && step()==Step::Welcome);
+  assert(saved_preferences.empty() && !local_files_present);
+  saved_preferences["first-use/step"]=255;assert(boot() && step()==Step::Welcome);
+}

