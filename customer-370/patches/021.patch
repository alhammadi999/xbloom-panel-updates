+++ b/tests/test_i18n.cpp
@@ -0,0 +1,14 @@
+#include "i18n.h"
+#include <Preferences.h>
+#include <Arduino.h>
+#include <cassert>
+#include <cstring>
+int main(){
+ saved_preferences.clear();i18n::begin();assert(!i18n::arabic());
+ assert(i18n::save_and_restart(true));assert(ESP.restarted);ESP.restarted=false;
+ i18n::begin();assert(i18n::arabic());assert(strcmp(i18n::tr("Screen"),"Screen"));
+ fail_save=true;assert(!i18n::save_and_restart(false));assert(!ESP.restarted);i18n::begin();assert(i18n::arabic());
+ fail_save=false;assert(i18n::save_and_restart(false));i18n::begin();assert(!i18n::arabic());
+ i18n::save_and_restart(true);i18n::begin();assert(i18n::arabic());
+ saved_preferences.clear();i18n::begin();assert(!i18n::arabic());
+}

